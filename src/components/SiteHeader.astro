---
import MobileNav from './MobileNav.astro';

const { path = '' } = Astro.props;
const nav = [
  { label: 'Knowledge base', href: '/knowledge-base' },
  { label: 'Technologies', href: '/knowledge-base#technologies' },
  { label: 'My work', href: '/work' },
  { label: 'Books', href: '/books' },
];
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href) && !href.includes('#'));
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <svg class="brand__mark" viewBox="0 0 30 30" aria-hidden="true">
        <rect x="1" y="19" width="28" height="4" rx="1" fill="var(--storage)" />
        <rect x="1" y="13" width="28" height="4" rx="1" fill="var(--table)" />
        <rect x="1" y="7" width="28" height="4" rx="1" fill="var(--catalog)" />
        <rect x="1" y="1" width="28" height="4" rx="1" fill="var(--engine)" />
      </svg>
      <span class="brand__text">
        <strong>Alex Merced</strong>
        <span>Open Lakehouse advocate</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <MobileNav items={[...nav, { label: 'Newsletters', href: '#newsletter' }, { label: 'AlexMerced.com', href: 'https://alexmerced.com' }]} />
  </div>
</header>

<style>
  .brand { text-decoration: none; }
  .brand__text { line-height: 1.15; }
</style>
