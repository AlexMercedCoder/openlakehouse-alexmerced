---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WebMCP from '../components/WebMCP.astro';
// Generated by alexmercedcom/scripts/build-network-shared.mjs. Read at build time; never edit or copy.
// The head file carries GA4 and the one canonical Person node (@id https://alexmerced.com/#alexmerced).
import networkHead from '../../network/network-head.html?raw';
import network from '../../network/network.json';

export interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes merged into the site graph for this page. */
  jsonLd?: Record<string, unknown>[];
  keywords?: string[];
  ogType?: 'website' | 'article';
}

const { title, description, jsonLd = [], keywords = [], ogType = 'website' } = Astro.props;

const SITE = 'https://openlakehouse.alexmerced.com';
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), SITE).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | Alex Merced, Open Lakehouse advocate`;

const baseGraph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    name: 'Alex Merced, Open Lakehouse advocate',
    url: `${SITE}/`,
    description:
      "Alex Merced's personal site on the open lakehouse: his perspective, work, and books. Neutral definitions live on OpenDataLakehouse.com.",
    inLanguage: 'en-US',
    publisher: { '@id': 'https://alexmerced.com/#alexmerced' },
  },
];

const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph, ...jsonLd] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    <meta name="author" content="Alex Merced" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#071720" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Alex Merced, Open Lakehouse advocate" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alex Merced, Open Lakehouse advocate" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={network.twitterSite} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <meta name="twitter:creator" content="@AMdatalakehouse" />

    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <Fragment set:html={networkHead} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <WebMCP />
    <SiteHeader path={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
